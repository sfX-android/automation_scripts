umask 0022
set -euo pipefail

commentPatches() {
    file="$1"
    if [ -f "$file" ]; then
        shift
        for var in "$@"
        do
            #escaped=$(printf "%q" "$var")
            #echo $escaped
            sed -i "$file" -e '\|'$var'| s|^#*|#|';
        done
    fi
}

commentPatchesFromFile() {
    local pattern_file="$1"
    local target="$2"
    
    # Validate inputs
    if [[ ! -f "$pattern_file" ]]; then
        echo "ERROR: pattern file missing!" >&2
        return 3
    fi
    
    if [[ ! -f "$target" ]]; then
        echo "ERROR: target file missing!" >&2
        return 2
    fi
    
    # Create temporary file for output
    export temp_file
    temp_file=$(mktemp) || {
        echo "ERROR: Failed to create temporary file" >&2
        return 4
    }
    
    # Cleanup on exit
    trap 'rm -f "$temp_file"' EXIT
    
    # Process files
    local pattern
    local line
    local commented
    
    # Read patterns into array, skipping empty lines and comments
    local patterns=()
    while IFS= read -r pattern; do
        # Skip empty lines and comments (lines starting with #)
        if [[ -z "$pattern" || "$pattern" =~ ^[[:space:]]*# ]]; then
            continue
        fi
        # Remove surrounding quotes and spaces if present
        pattern="${pattern#\"}"
        pattern="${pattern%\"}"
        pattern="${pattern# }"
        pattern="${pattern% }"
        patterns+=("$pattern")
    done < "$pattern_file"
    
    # Process target file
    while IFS= read -r line; do
        commented=false
        
        # Check if line contains any pattern
        for pattern in "${patterns[@]}"; do
            # Use case-insensitive matching and handle special characters properly
            if [[ "$line" == *"$pattern"* ]]; then
                echo "#$line"
                commented=true
                break
            fi
        done
        
        # If not commented, output as is
        if [[ "$commented" == false ]]; then
            echo "$line"
        fi
    done < "$target" > "$temp_file"
    
    # Atomically replace target file
    mv "$temp_file" "$target"
}; export -f commentPatchesFromFile

